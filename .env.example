# =============================================================================
# THINHUW - Environment Variables Example
# =============================================================================

NODE_ENV=production
API_PORT=3000
CORS_ORIGINS=*

DATABASE_URL="mysql://user:password@host:port/dbname"

JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESEND=3
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MODE=email

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM="Thinhuw <your_email@gmail.com>"

# Cloudinary (Permanent Storage for Avatars)
CLOUDINARY_CLOUD_NAME=b1dl05nx
CLOUDINARY_API_KEY=472846493734395
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
